{
  "name": "oped-finder",
  "version": "0.1.0",
  "private": true,
  "description": "OPED Finder - busca e gerenciamento de aberturas e encerramentos de anime",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "desktop": "concurrently -k \"vite --port 5180\" \"wait-on http://localhost:5180 && cross-env VITE_DEV_SERVER_URL=http://localhost:5180 electron electron/main.cjs\"",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "start": "electron electron/main.cjs",
    "analyze": "node scripts/analyze.mjs",
    "batch": "node scripts/batch.mjs",
    "batch:dry": "node scripts/batch.mjs --dry --v"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^39.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "wait-on": "^9.0.0"
  }
}
